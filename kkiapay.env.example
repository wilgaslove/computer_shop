# --- KkiaPay (copiez dans votre .env, ne partagez jamais ces valeurs) ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
# Secret du webhook : celui que VOUS saisissez dans Dashboard KkiaPay > Webhooks
KKIAPAY_WEBHOOK_SECRET=
# true = sandbox (tests) ; false = production avec les clés live
KKIAPAY_SANDBOX=true
